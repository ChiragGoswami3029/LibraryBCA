# The connection string to your Neon PostgreSQL database
DATABASE_URL="postgresql://user:password@ep-cool-db-1234.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Secret key for signing JWT tokens (generate a random string)
JWT_SECRET_KEY="your-super-secret-jwt-key"

# Cloudinary credentials for storing uploaded PDFs
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# The URL of your React frontend (e.g., http://localhost:5173 for local testing)
FRONTEND_ORIGIN="http://localhost:5173"
